{
  "name": "p2flux/sdk-php",
  "description": "P2Flux payment execution client. Your application keeps the subscription lifecycle; this charges when you say a renewal is due.",
  "type": "library",
  "license": "MIT",
  "keywords": ["payments", "usdc", "stablecoin", "base", "subscriptions", "recurring", "checkout", "erc20"],
  "homepage": "https://p2flux.com",
  "support": {
    "issues": "https://github.com/P2Flux/sdk-php/issues",
    "source": "https://github.com/P2Flux/sdk-php",
    "docs": "https://p2flux.com/docs/"
  },
  "require": {
    "php": ">=8.1",
    "ext-json": "*"
  },
  "suggest": {
    "ext-curl": "Only for the default transport. A host that passes its own `transport` (WordPress, Guzzle, Symfony HttpClient) never loads it."
  },
  "autoload": {
    "psr-4": {
      "P2Flux\\": "src/"
    }
  },
  "scripts": {
    "test": [
      "@test:transport",
      "@test:examples",
      "@test:docs"
    ],
    "test:transport": "php tests/transport.php",
    "test:examples": "php tests/examples.php",
    "test:docs": "php tests/docs.php"
  },
  "config": {
    "sort-packages": true
  }
}
